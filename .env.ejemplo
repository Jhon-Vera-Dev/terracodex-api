# Variables de entorno de terracodex-api en producción (Dokploy → Environment).
# Copia los nombres; nunca subas los valores reales al repositorio.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL. En Dokploy usa el "Internal Host" de la base creada en el mismo proyecto.
DB_URL=jdbc:postgresql://<host-interno-postgres>:5432/terracodex
DB_USER=terracodex
DB_PASSWORD=<contraseña-larga-aleatoria>

# Clave HS256 de al menos 32 caracteres. Genera una con: openssl rand -base64 48
# Si cambia, todas las sesiones se cierran.
JWT_SECRET=<clave-aleatoria-de-48-bytes>

# Primer administrador: se crea al arrancar solo si no hay usuarios (8 a 72 caracteres, letras y números).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<contraseña-del-admin>

# Solo si el frontend corre en un navegador (flet build web). Varios orígenes separados por coma.
CORS_ALLOWED_ORIGINS=https://app.tudominio.com
