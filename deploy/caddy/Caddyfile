# Con DOMINIO (por ejemplo api.tudominio.com) Caddy obtiene y renueva solo el certificado HTTPS de Let's Encrypt;
# el dominio debe apuntar a la IP del VPS (registro A) antes de arrancar.
# Sin DOMINIO escucha en :80 por HTTP: sirve para probar con la IP, pero las contraseñas viajan sin cifrar.

{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Solo se publica el API y el health; el resto del actuator no sale a internet
	@publico path /api/* /actuator/health /actuator/health/*
	handle @publico {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8080
	}

	# APK de la app para instalar en Android (lo genera deploy/apk/construir-apk.sh)
	handle /descargas/* {
		root * /srv
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Content-Disposition "attachment"
		header @apk Cache-Control "no-cache"
		file_server
	}

	# App TerraCode en el navegador (contenedor web, Flet, servida bajo /app/). Caddy pasa el WebSocket de cada
	# sesión sin configuración extra. Si el contenedor no está levantado (perfil "web"), responde 502.
	@app path /app /app/*
	handle @app {
		# El cliente web de Flet (~6 MB: main.dart.js, canvaskit) solo cambia al actualizar Flet, no con nuestro
		# código (que corre en el servidor): el navegador lo guarda un día y luego revalida con ETag. Sin esto se
		# descarga entero en cada entrada, también al volver del login con Google.
		@cliente {
			path /app/*.js /app/*.mjs /app/*.wasm /app/canvaskit/* /app/assets/* /app/icons/* /app/*.png
			not path /app/flutter_service_worker.js
		}
		header @cliente Cache-Control "public, max-age=86400"
		reverse_proxy web:8551
	}

	# Landing (deploy/landing, estática) en la raíz del dominio
	# /privacidad sirve privacidad.html (URL de la política para Google)
	handle {
		root * /srv/landing
		try_files {path} {path}.html
		file_server
	}
}

# Explorador de TerraSprout en su propio subdominio. Muestra sus páginas en iframes (WebView), y la landing del
# dominio principal abre su asistente en un iframe: se permite enmarcarlo desde sí mismo y desde {$DOMINIO}.
{$EXPLORADOR_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMINIO}"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy explorador:8551
}
