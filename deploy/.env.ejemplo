# Copia este archivo a deploy/.env en el servidor y completa los valores. deploy/.env nunca va al repositorio.

# Vacío: HTTP en la IP del VPS (solo pruebas). Con dominio: HTTPS automático, p. ej. api.tudominio.com
DOMINIO=
# Subdominio del explorador de TerraSprout, por ejemplo explorador.tudominio.com (registro A a la IP del VPS)
EXPLORADOR_DOMINIO=

POSTGRES_DB=terracodex
POSTGRES_USER=terracodex
# Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=

# Clave HS256 de al menos 32 caracteres. Genera con: openssl rand -base64 48
# Si cambia, todas las sesiones se cierran.
JWT_SECRET=

# Primer administrador: se crea al arrancar solo si la base no tiene usuarios (8 a 72 caracteres, letras y números)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Solo si el frontend corre en un navegador (flet build web). Varios orígenes separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Clave compartida entre la API y servicio-ml (red interna). Genera con: openssl rand -hex 32
ML_API_KEY=

# Login con Google (opcional). Cliente OAuth "Aplicación web" en Google Cloud → Credenciales.
# URI de redireccionamiento autorizado: https://<DOMINIO>/api/auth/google/callback (la misma que GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.rapiditto.com/api/auth/google/callback
